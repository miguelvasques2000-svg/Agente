# Copia este ficheiro para ".env" e preenche os valores.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# --- Telegram ---
# 1. Fala com @BotFather no Telegram, cria um bot com /newbot e copia o token.
# 2. Envia uma mensagem qualquer ao teu bot e depois abre:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    para descobrires o teu chat_id em "message.chat.id".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp (via CallMeBot, gratuito para uso pessoal) ---
# 1. Adiciona o número +34 644 59 71 65 aos teus contactos.
# 2. Envia-lhe a mensagem: "I allow callmebot to send me messages"
# 3. Vais receber uma apikey por WhatsApp.
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
